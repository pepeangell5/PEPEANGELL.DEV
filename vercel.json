{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/assets/mascot-esp32-tools-v2\\.png$",
      "dest": "/assets/optimized/mascot-esp32-tools-v2-1254.f6e17cb744.webp"
    },
    {
      "src": "^/assets/shop/esp32-devkit-kit\\.jpg$",
      "dest": "/assets/optimized/esp32-devkit-kit-720.9fe47e4cc5.webp"
    },
    {
      "src": "^/assets/shop/esp32-c3-supermini-kit\\.jpg$",
      "dest": "/assets/optimized/esp32-c3-supermini-kit-720.19cdd1160f.webp"
    },
    {
      "src": "^/assets/mascot-neon-cut\\.png$",
      "dest": "/assets/optimized/mascot-neon-cut-1254.f6e17cb744.webp"
    },
    {
      "src": "^/assets/mascot-classic-cut\\.png$",
      "dest": "/assets/optimized/mascot-classic-cut-980.860df4b599.webp"
    },
    {
      "src": "^/assets/optimized/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/api/site-total$",
      "dest": "https://pepeangell.goatcounter.com/counter/TOTAL.json"
    },
    {
      "src": "^/finanzas$",
      "dest": "https://finanzas-pepeangell.vercel.app/finanzas"
    },
    {
      "src": "^/finanzas/(.*)$",
      "dest": "https://finanzas-pepeangell.vercel.app/finanzas/$1"
    }
  ]
}
