---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WardrivingMap from "../../components/WardrivingMap.astro";
---

<BaseLayout
  title="Mapa Wardriving"
  description="Genera un mapa interactivo de wardriving directamente en tu navegador a partir de un archivo WARD_DRIVE.csv."
>
  <section class="section wardriving-page">
    <div class="container">
      <div class="section-header wardriving-page__header">
        <p class="eyebrow" data-translate-en="GPS · WIFI · LOCAL CSV">GPS · WIFI · CSV LOCAL</p>
        <h1 data-translate-en="Wardriving Map">Mapa Wardriving</h1>
        <p data-translate-en="Load the CSV generated by CYBERDECK MINI ESP32 V2 to trace the GPS route and inspect the networks detected at each point.">
          Carga el CSV generado por CYBERDECK MINI ESP32 V2 para trazar la ruta GPS y consultar las redes detectadas en cada punto.
        </p>
      </div>

      <WardrivingMap />
    </div>
  </section>
</BaseLayout>

<style>
  .wardriving-page {
    padding-top: clamp(36px, 6vw, 72px);
  }

  .wardriving-page > .container {
    max-width: 1680px;
    padding-inline: clamp(12px, 2vw, 28px);
  }

  .wardriving-page__header {
    max-width: 820px;
    margin-bottom: 28px;
  }

  .wardriving-page__header p:last-child {
    max-width: 720px;
  }
</style>
