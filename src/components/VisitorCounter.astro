---
const goatCounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---

<div class="visitor-counter" data-goatcounter-code={goatCounterCode || undefined}>
  <span class="visitor-counter-label">Visitas reales</span>
  <strong id="visitor-counter-total" class="visitor-counter-value">{goatCounterCode ? "..." : "privado"}</strong>
</div>

{
  goatCounterCode && (
    <script is:inline>
      (() => {
        const widget = document.querySelector("[data-goatcounter-code]");
        const value = document.querySelector("#visitor-counter-total");
        if (!widget || !value) return;

        const code = widget.getAttribute("data-goatcounter-code");
        const cacheKey = "esp32-tools-visitor-count-v1";
        const urls = [
          "/api/site-total",
          `https://${code}.goatcounter.com/counter/TOTAL.json`,
        ];

        const readCounter = (url) => fetch(url, { headers: { Accept: "application/json" } })
          .then((response) => {
            if (!response.ok) throw new Error("counter unavailable");
            return response.json();
          })
          .then((data) => {
            if (!data.count) throw new Error("invalid counter");
            return String(data.count);
          });

        const tryNext = (index) => {
          if (index >= urls.length) return Promise.reject(new Error("counter unavailable"));
          return readCounter(urls[index]).catch(() => tryNext(index + 1));
        };

        tryNext(0)
          .then((count) => {
            value.textContent = count;
            try {
              localStorage.setItem(cacheKey, count);
            } catch {}
          })
          .catch(() => {
            let cachedCount = "";
            try {
              cachedCount = localStorage.getItem(cacheKey) || "";
            } catch {}
            value.textContent = cachedCount || "no disponible";
            widget.setAttribute("title", "El contador no pudo actualizarse en este navegador.");
          });
      })();
    </script>
  )
}
