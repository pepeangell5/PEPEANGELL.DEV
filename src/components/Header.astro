---
import { sitePath } from "../utils/paths";
import { mascotImage } from "../lib/imageAssets";
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

const repositoryLinks = [
  { href: "/firmware/", label: "Firmware" },
  { href: "/repos/", label: "Repos" },
  { href: "/flashers/", label: "Flashers" },
  { href: "/hardware/", label: "Hardware" }
];

const laboratoryLinks = [
  { href: "/code-simulator/", label: "Code Simulator" },
  { href: "/hardware-lab/", label: "Simulador PCB" }
];

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isCurrent = (href: string) => normalizedPathname === href;
const repositoryIsCurrent = repositoryLinks.some((link) => isCurrent(link.href));
const laboratoryIsCurrent = laboratoryLinks.some((link) => isCurrent(link.href));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={sitePath("/")} aria-label="ESP32-TOOLS home">
      <img
        class="brand-mark"
        src={sitePath(mascotImage.icon)}
        alt=""
        width="96"
        height="96"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
      <span>ESP32-TOOLS</span>
    </a>
    <nav class="nav-links" aria-label="Navegacion principal">
      <a href={sitePath("/")} aria-current={isCurrent("/") ? "page" : undefined}>Inicio</a>
      <a href={sitePath("/support/")} aria-current={isCurrent("/support/") ? "page" : undefined}>Apoyo</a>
      <a href={sitePath("/shop/")} aria-current={isCurrent("/shop/") ? "page" : undefined}>Tienda</a>

      <details class:list={["nav-group", { "is-active": repositoryIsCurrent }]}>
        <summary>Repositorios</summary>
        <div class="nav-group-menu" aria-label="Repositorios">
          {
            repositoryLinks.map((link) => (
              <a href={sitePath(link.href)} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </details>

      <a href={sitePath("/downloads/")} aria-current={isCurrent("/downloads/") ? "page" : undefined}>Descargas</a>

      <details class:list={["nav-group", { "is-active": laboratoryIsCurrent }]}>
        <summary>Laboratorio</summary>
        <div class="nav-group-menu" aria-label="Laboratorio">
          {
            laboratoryLinks.map((link) => (
              <a href={sitePath(link.href)} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </details>

      <a href={sitePath("/news/")} aria-current={isCurrent("/news/") ? "page" : undefined}>Noticias</a>
      <a href={sitePath("/contact/")} aria-current={isCurrent("/contact/") ? "page" : undefined}>Contacto</a>
    </nav>
    <button class="nav-menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-nav-toggle>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <ThemeToggle />
    <LanguageToggle />
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector(".nav-links");
  const navGroups = document.querySelectorAll(".nav-group");
  const themeButtons = document.querySelectorAll("[data-theme-option]");
  const themeStorageKey = "pepeangell-labs-theme-v1";

  function setTheme(theme) {
    const normalizedTheme = theme === "light" ? "light" : "dark";
    document.documentElement.dataset.theme = normalizedTheme;

    themeButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.setAttribute("aria-pressed", String(button.dataset.themeOption === normalizedTheme));
    });

    try {
      localStorage.setItem(themeStorageKey, normalizedTheme);
    } catch {}
  }

  try {
    setTheme(localStorage.getItem(themeStorageKey) ?? document.documentElement.dataset.theme ?? "dark");
  } catch {
    setTheme("dark");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    nav?.classList.toggle("open", !isOpen);
  });

  nav?.addEventListener("click", (event) => {
    if (!(event.target instanceof HTMLAnchorElement)) return;
    toggle?.setAttribute("aria-expanded", "false");
    nav.classList.remove("open");
    navGroups.forEach((group) => group.removeAttribute("open"));
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    navGroups.forEach((group) => {
      if (!group.contains(event.target)) group.removeAttribute("open");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    toggle?.setAttribute("aria-expanded", "false");
    nav?.classList.remove("open");
    navGroups.forEach((group) => group.removeAttribute("open"));
  });

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) return;
      setTheme(button.dataset.themeOption);
    });
  });

  document.addEventListener(
    "wheel",
    (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement) || field.type !== "number") return;
      if (document.activeElement !== field) return;
      event.preventDefault();
    },
    { passive: false }
  );
</script>
