---
import "leaflet/dist/leaflet.css";
---

<div class="wardriving-tool" data-wardriving-tool>
  <section class="wardriving-upload" aria-labelledby="wardriving-upload-title">
    <div class="wardriving-upload__copy">
      <span class="wardriving-upload__badge" data-translate-en="LOCAL PROCESSING">PROCESAMIENTO LOCAL</span>
      <h2 id="wardriving-upload-title" data-translate-en="Upload one or more wardriving CSV files">Adjunta uno o varios CSV de wardriving</h2>
      <p data-translate-en="Combine several routes on the same map. Files are processed only in your browser; they are never uploaded or stored on the website.">
        Combina varios recorridos en un mismo mapa. Los archivos se procesan únicamente en tu navegador; nunca se suben ni se almacenan en la página.
      </p>
    </div>

    <label class="wardriving-dropzone" data-dropzone>
      <input type="file" accept=".csv,text/csv" multiple data-file-input />
      <span class="wardriving-dropzone__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" />
          <path d="M5 13.5v4A2.5 2.5 0 0 0 7.5 20h9a2.5 2.5 0 0 0 2.5-2.5v-4" />
        </svg>
      </span>
      <strong data-translate-en="Drop one or more CSV files here">Arrastra uno o varios archivos CSV aquí</strong>
      <span data-translate-en="or click to select them from your device">o haz clic para seleccionarlos desde tu dispositivo</span>
      <small>CSV · UTF-8 / Windows-1252 · 25 MB por archivo · 100 MB en total</small>
    </label>

    <div class="wardriving-columns" aria-label="Columnas requeridas">
      <span>Lat</span><span>Lng</span><span>SSID</span><span>BSSID</span><span>RSSI</span><span>Channel</span><span>Auth</span>
    </div>

    <p class="wardriving-status" role="status" aria-live="polite" data-status data-state="idle" data-no-translate>
      Selecciona un archivo CSV para comenzar.
    </p>
  </section>

  <section class="wardriving-results" data-results hidden aria-labelledby="wardriving-results-title">
    <div class="wardriving-results__header">
      <div>
        <span class="wardriving-results__eyebrow" data-translate-en="GENERATED MAP">MAPA GENERADO</span>
        <h2 id="wardriving-results-title" data-file-name data-no-translate>WARD_DRIVE.csv</h2>
      </div>
      <div class="wardriving-actions">
        <button class="button" type="button" data-add-files data-translate-en="Add more CSV files">
          Agregar más CSV
        </button>
        <button class="button" type="button" data-download-map data-translate-en="Download HTML map">
          Descargar mapa HTML
        </button>
        <button class="button" type="button" data-clear-map data-translate-en="Use other CSV files">
          Usar otros CSV
        </button>
      </div>
    </div>

    <div class="wardriving-stats" aria-label="Resumen del archivo">
      <article><span data-translate-en="Files">Archivos</span><strong data-stat="files">0</strong></article>
      <article><span data-translate-en="Records">Registros</span><strong data-stat="records">0</strong></article>
      <article><span data-translate-en="GPS points">Puntos GPS</span><strong data-stat="gps">0</strong></article>
      <article><span data-translate-en="Unique APs">AP únicos</span><strong data-stat="aps">0</strong></article>
      <article><span data-translate-en="Open APs">AP abiertos</span><strong data-stat="open">0</strong></article>
      <article><span data-translate-en="No location">Sin ubicación</span><strong data-stat="discarded">0</strong></article>
    </div>

    <div class="wardriving-explorer">
      <div class="wardriving-map-shell">
        <div class="wardriving-map" data-map aria-label="Mapa interactivo de la ruta de wardriving"></div>
        <label class="wardriving-basemap-control">
          <span data-translate-en="Map type">Tipo de mapa</span>
          <select data-basemap-select>
            <option value="streets" data-translate-en="Streets">Calles</option>
            <option value="satellite" data-translate-en="Satellite">Satélite</option>
            <option value="osm">OpenStreetMap</option>
            <option value="dark" data-translate-en="Dark">Oscuro</option>
            <option value="topographic" data-translate-en="Topographic">Topográfico</option>
          </select>
        </label>
        <div class="wardriving-legend" aria-label="Leyenda del mapa">
          <span><i class="is-start"></i><b data-translate-en="Start">Inicio</b></span>
          <span><i class="is-observation"></i><b data-translate-en="Observation">Observación</b></span>
          <span><i class="is-end"></i><b data-translate-en="End">Final</b></span>
        </div>
      </div>

      <aside class="wardriving-networks" aria-labelledby="wardriving-networks-title">
        <div class="wardriving-networks__header">
          <div>
            <span data-translate-en="DETECTED NETWORKS">REDES DETECTADAS</span>
            <h3 id="wardriving-networks-title" data-translate-en="Network details">Detalles de redes</h3>
          </div>
          <strong data-network-count data-no-translate>0</strong>
        </div>
        <label class="wardriving-network-search">
          <span class="sr-only" data-translate-en="Search detected networks">Buscar redes detectadas</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input type="search" placeholder="Buscar SSID, BSSID, canal…" data-network-search />
        </label>
        <div class="wardriving-network-filters">
          <label>
            <span data-translate-en="Security filter">Filtro de seguridad</span>
            <select data-security-filter>
              <option value="all" data-translate-en="All networks">Todas las redes</option>
              <option value="open" data-translate-en="Open networks">Redes abiertas</option>
              <option value="protected" data-translate-en="Protected networks">Redes protegidas</option>
              <option value="wep">WEP</option>
              <option value="wpa">WPA</option>
              <option value="wpa2">WPA2</option>
              <option value="wpa3">WPA3</option>
              <option value="other" data-translate-en="Other security">Otra seguridad</option>
            </select>
          </label>
          <button type="button" data-reset-filters data-translate-en="Clear filters">Limpiar filtros</button>
        </div>
        <div class="wardriving-network-list" data-network-list data-no-translate></div>
        <p class="wardriving-network-empty" data-network-empty hidden data-translate-en="No networks match the selected filters.">
          No hay redes que coincidan con los filtros seleccionados.
        </p>
      </aside>
    </div>

    <p class="wardriving-results__notice" data-translate-en="The map tiles require an Internet connection. Review and anonymize the file before sharing the downloaded HTML because it contains route and nearby network data.">
      El mapa base necesita Internet. Revisa y anonimiza el archivo antes de compartir el HTML descargado porque contiene la ruta y datos de redes próximas.
    </p>
  </section>
</div>

<script>
  import L from "leaflet";
  import {
    buildStandaloneWardrivingHtml,
    decodeWardrivingFile,
    mergeWardrivingMaps,
    parseWardrivingCsv,
    type WardrivingMapData,
    type WardrivingMarker,
  } from "../lib/wardriving";

  const root = document.querySelector<HTMLElement>("[data-wardriving-tool]");

  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-file-input]");
    const dropzone = root.querySelector<HTMLElement>("[data-dropzone]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const results = root.querySelector<HTMLElement>("[data-results]");
    const mapElement = root.querySelector<HTMLElement>("[data-map]");
    const basemapSelect = root.querySelector<HTMLSelectElement>("[data-basemap-select]");
    const fileNameElement = root.querySelector<HTMLElement>("[data-file-name]");
    const downloadButton = root.querySelector<HTMLButtonElement>("[data-download-map]");
    const addFilesButton = root.querySelector<HTMLButtonElement>("[data-add-files]");
    const clearButton = root.querySelector<HTMLButtonElement>("[data-clear-map]");
    const networkList = root.querySelector<HTMLElement>("[data-network-list]");
    const networkCount = root.querySelector<HTMLElement>("[data-network-count]");
    const networkSearch = root.querySelector<HTMLInputElement>("[data-network-search]");
    const securityFilter = root.querySelector<HTMLSelectElement>("[data-security-filter]");
    const resetFiltersButton = root.querySelector<HTMLButtonElement>("[data-reset-filters]");
    const networkEmpty = root.querySelector<HTMLElement>("[data-network-empty]");

    const MAX_FILE_SIZE = 25 * 1024 * 1024;
    const MAX_TOTAL_SIZE = 100 * 1024 * 1024;
    const copy = {
      es: {
        idle: "Selecciona un archivo CSV para comenzar.",
        reading: "Leyendo y validando el archivo…",
        ready: (fileName: string) => `${fileName} se procesó correctamente.`,
        tooLarge: "El archivo supera el límite de 25 MB.",
        totalTooLarge: "Los archivos superan el límite total de 100 MB.",
        invalidType: "Selecciona un archivo con extensión .csv.",
        error: (message: string) => `No se pudo generar el mapa: ${message}`,
        popupTitle: (count: number) => `${count} red${count === 1 ? "" : "es"}`,
        hiddenSsid: "[SSID oculto]",
        security: "Seguridad",
        channel: "Canal",
        latitude: "Latitud",
        longitude: "Longitud",
        source: "Archivo",
        observations: (visible: number, total: number) => visible === total ? `${total} observaciones` : `${visible} de ${total}`,
        searchPlaceholder: "Buscar SSID, BSSID, canal…",
      },
      en: {
        idle: "Select a CSV file to begin.",
        reading: "Reading and validating the file…",
        ready: (fileName: string) => `${fileName} was processed successfully.`,
        tooLarge: "The file exceeds the 25 MB limit.",
        totalTooLarge: "The files exceed the 100 MB total limit.",
        invalidType: "Select a file with a .csv extension.",
        error: (message: string) => `The map could not be generated: ${message}`,
        popupTitle: (count: number) => `${count} network${count === 1 ? "" : "s"}`,
        hiddenSsid: "[Hidden SSID]",
        security: "Security",
        channel: "Channel",
        latitude: "Latitude",
        longitude: "Longitude",
        source: "File",
        observations: (visible: number, total: number) => visible === total ? `${total} observations` : `${visible} of ${total}`,
        searchPlaceholder: "Search SSID, BSSID, channel…",
      },
    };

    let currentData: WardrivingMapData | null = null;
    let currentStatus: { state: "idle" | "reading" | "ready" | "error"; detail?: string } = { state: "idle" };
    let map: L.Map | null = null;
    let baseLayer: L.TileLayer | null = null;
    let markerLayers: L.CircleMarker[] = [];
    type SecurityFilter = "all" | "open" | "protected" | "wep" | "wpa" | "wpa2" | "wpa3" | "other";

    const language = () => document.documentElement.lang === "en" ? "en" : "es";
    const basemaps: Record<string, { url: string; options: L.TileLayerOptions }> = {
      streets: {
        url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
        options: { maxZoom: 19, attribution: "Tiles &copy; Esri" },
      },
      satellite: {
        url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        options: { maxZoom: 19, attribution: "Tiles &copy; Esri, Maxar, Earthstar Geographics" },
      },
      osm: {
        url: "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        options: { maxZoom: 19, attribution: "&copy; OpenStreetMap contributors" },
      },
      dark: {
        url: "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
        options: { maxZoom: 20, subdomains: "abcd", attribution: "&copy; OpenStreetMap contributors &copy; CARTO" },
      },
      topographic: {
        url: "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
        options: { maxZoom: 17, attribution: "Map data &copy; OpenStreetMap contributors · Style &copy; OpenTopoMap" },
      },
    };

    function applyBasemap() {
      if (!map) return;
      const selected = basemaps[basemapSelect?.value ?? "streets"] ?? basemaps.streets;
      baseLayer?.remove();
      baseLayer = L.tileLayer(selected.url, selected.options).addTo(map);
    }

    if (mapElement && "ResizeObserver" in window) {
      let resizeFrame = 0;
      const mapResizeObserver = new ResizeObserver(() => {
        window.cancelAnimationFrame(resizeFrame);
        resizeFrame = window.requestAnimationFrame(() => map?.invalidateSize({ pan: false }));
      });
      mapResizeObserver.observe(mapElement);
    }

    function updateStatus(state: typeof currentStatus.state, detail?: string) {
      if (!status) return;
      currentStatus = { state, detail };
      const messages = copy[language()];
      const text = state === "ready"
        ? messages.ready(detail ?? "CSV")
        : state === "error"
          ? detail ?? messages.error("CSV inválido")
          : messages[state];
      status.textContent = text;
      status.dataset.state = state;
    }

    function createTextRow(label: string, value: string) {
      const row = document.createElement("span");
      row.textContent = `${label}: ${value || "—"}`;
      return row;
    }

    function createPopup(point: WardrivingMarker) {
      const messages = copy[language()];
      const popup = document.createElement("div");
      popup.className = "wardriving-popup";
      popup.dataset.noTranslate = "";

      const heading = document.createElement("h3");
      heading.textContent = messages.popupTitle(point.networks.length);
      popup.append(heading);

      point.networks.forEach((network) => {
        const card = document.createElement("div");
        card.className = "wardriving-popup__network";
        const name = document.createElement("strong");
        name.textContent = network.ssid || messages.hiddenSsid;
        card.append(
          name,
          createTextRow("BSSID", network.bssid),
          createTextRow("RSSI", `${network.rssi || "—"} dBm · ${messages.channel}: ${network.channel || "—"}`),
          createTextRow(messages.security, network.auth),
          createTextRow(messages.source, network.sourceFile),
        );
        popup.append(card);
      });
      return popup;
    }

    function renderMap(data: WardrivingMapData) {
      if (!mapElement) return;
      map?.remove();
      mapElement.replaceChildren();
      baseLayer = null;
      markerLayers = [];

      map = L.map(mapElement, { preferCanvas: true, zoomControl: true }).setView(data.center, 15);
      applyBasemap();

      const routeColors = ["#28d7ec", "#ff70c7", "#29ef9f", "#ffb454", "#a98bff", "#5aa9ff"];
      const bounds = L.latLngBounds([]);
      const starts = new Set(data.routes.map((route) => route[0]).filter(Boolean).map((point) => point.join("|")));
      const ends = new Set(data.routes.map((route) => route.at(-1)).filter(Boolean).map((point) => point.join("|")));

      data.routes.forEach((route, index) => {
        if (!route.length) return;
        L.polyline(route, {
          color: routeColors[index % routeColors.length],
          weight: 5,
          opacity: 0.9,
          lineJoin: "round",
        }).addTo(map as L.Map);
        route.forEach((point) => bounds.extend(point));
      });

      data.markers.forEach((point, index) => {
        const positionKey = `${point.lat}|${point.lng}`;
        const marker = L.circleMarker([point.lat, point.lng], {
          radius: Math.min(12, 5 + Math.sqrt(point.networks.length)),
          color: starts.has(positionKey) ? "#29ef9f" : "#101426",
          weight: 2,
          fillColor: ends.has(positionKey) ? "#ff547d" : "#ff70c7",
          fillOpacity: 0.95,
        }).bindPopup(createPopup(point), { maxWidth: 360 }).addTo(map as L.Map);
        markerLayers.push(marker);
        bounds.extend([point.lat, point.lng]);
      });

      if (bounds.isValid()) map.fitBounds(bounds, { padding: [42, 42] });
      window.setTimeout(() => map?.invalidateSize(), 0);
    }

    function selectedSecurityFilter() {
      return (securityFilter?.value ?? "all") as SecurityFilter;
    }

    function matchesSecurity(auth: string, selected: SecurityFilter) {
      if (selected === "all") return true;
      const normalized = auth.trim().toUpperCase();
      const isOpen = ["OPEN", "NONE", "OPN", "0"].includes(normalized) || normalized.includes("OPEN");
      const protocols = new Set(normalized.match(/WPA3|WPA2|WPA|WEP/g) ?? []);

      if (selected === "open") return isOpen;
      if (selected === "protected") return !isOpen;
      if (selected === "other") return !isOpen && protocols.size === 0;
      return protocols.has(selected.toUpperCase());
    }

    function matchesSearch(point: WardrivingMarker, network: WardrivingMarker["networks"][number], normalizedQuery: string) {
      if (!normalizedQuery) return true;
      return [
        network.ssid,
        network.bssid,
        network.rssi,
        network.channel,
        network.auth,
        network.sourceFile,
        String(point.lat),
        String(point.lng),
      ].some((value) => value.toLowerCase().includes(normalizedQuery));
    }

    function updateMapFilters(data: WardrivingMapData, normalizedQuery: string, selected: SecurityFilter, fitMap: boolean) {
      if (!map) return;
      const visibleBounds = L.latLngBounds([]);

      data.markers.forEach((point, pointIndex) => {
        const marker = markerLayers[pointIndex];
        if (!marker) return;
        const matchingNetworks = point.networks.filter((network) =>
          matchesSecurity(network.auth, selected) && matchesSearch(point, network, normalizedQuery)
        );

        if (matchingNetworks.length) {
          if (!map?.hasLayer(marker)) marker.addTo(map as L.Map);
          marker.setRadius(Math.min(12, 5 + Math.sqrt(matchingNetworks.length)));
          marker.bindPopup(createPopup({ ...point, networks: matchingNetworks }), { maxWidth: 360 });
          visibleBounds.extend([point.lat, point.lng]);
        } else if (map.hasLayer(marker)) {
          map.removeLayer(marker);
        }
      });

      if (fitMap && visibleBounds.isValid()) {
        map.fitBounds(visibleBounds, { padding: [54, 54], maxZoom: 17 });
      }
    }

    function renderNetworkList(data: WardrivingMapData, query = "", selected = selectedSecurityFilter(), fitMap = false) {
      if (!networkList) return;
      const messages = copy[language()];
      const normalizedQuery = query.trim().toLowerCase();
      const observations = data.markers.flatMap((point, pointIndex) =>
        point.networks.map((network) => ({ point, pointIndex, network }))
      );
      const visible = observations.filter(({ point, network }) =>
        matchesSecurity(network.auth, selected) && matchesSearch(point, network, normalizedQuery)
      );

      updateMapFilters(data, normalizedQuery, selected, fitMap);

      networkList.replaceChildren();
      visible.forEach(({ point, pointIndex, network }, index) => {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "wardriving-network-card";
        card.setAttribute("aria-label", `${network.ssid || messages.hiddenSsid}, ${messages.latitude} ${point.lat}, ${messages.longitude} ${point.lng}`);

        const heading = document.createElement("span");
        heading.className = "wardriving-network-card__heading";
        const name = document.createElement("strong");
        name.textContent = network.ssid || messages.hiddenSsid;
        const sequence = document.createElement("i");
        sequence.textContent = `#${index + 1}`;
        heading.append(name, sequence);

        const bssid = document.createElement("span");
        bssid.className = "wardriving-network-card__bssid";
        const bssidLabel = document.createElement("small");
        bssidLabel.textContent = "BSSID";
        const bssidValue = document.createElement("code");
        bssidValue.textContent = network.bssid || "—";
        bssid.append(bssidLabel, bssidValue);

        const coordinates = document.createElement("span");
        coordinates.className = "wardriving-network-card__coordinates";
        [
          [messages.latitude, point.lat.toFixed(6)],
          [messages.longitude, point.lng.toFixed(6)],
        ].forEach(([label, value]) => {
          const item = document.createElement("span");
          const itemLabel = document.createElement("small");
          const itemValue = document.createElement("b");
          itemLabel.textContent = label;
          itemValue.textContent = value;
          item.append(itemLabel, itemValue);
          coordinates.append(item);
        });

        const source = document.createElement("span");
        source.className = "wardriving-network-card__source";
        const sourceLabel = document.createElement("small");
        sourceLabel.textContent = messages.source;
        const sourceValue = document.createElement("b");
        sourceValue.textContent = network.sourceFile;
        source.append(sourceLabel, sourceValue);

        const details = document.createElement("span");
        details.className = "wardriving-network-card__details";
        [
          ["RSSI", `${network.rssi || "—"} dBm`],
          [messages.channel, network.channel || "—"],
          [messages.security, network.auth || "—"],
        ].forEach(([label, value]) => {
          const item = document.createElement("span");
          const itemLabel = document.createElement("small");
          const itemValue = document.createElement("b");
          itemLabel.textContent = label;
          itemValue.textContent = value;
          item.append(itemLabel, itemValue);
          details.append(item);
        });

        card.append(heading, bssid, coordinates, source, details);
        card.addEventListener("click", () => {
          networkList.querySelectorAll(".wardriving-network-card").forEach((item) => item.removeAttribute("aria-current"));
          card.setAttribute("aria-current", "true");
          if (map) {
            map.setView([point.lat, point.lng], Math.max(map.getZoom(), 17), { animate: true });
            markerLayers[pointIndex]?.openPopup();
          }
        });
        networkList.append(card);
      });

      if (networkCount) networkCount.textContent = messages.observations(visible.length, observations.length);
      if (networkEmpty) networkEmpty.hidden = visible.length > 0;
      if (networkSearch) networkSearch.placeholder = messages.searchPlaceholder;
    }

    function renderResults(data: WardrivingMapData) {
      currentData = data;
      const resultName = data.fileNames.length === 1
        ? data.fileName
        : language() === "en"
          ? `${data.fileNames.length} combined files`
          : `${data.fileNames.length} archivos combinados`;
      if (fileNameElement) fileNameElement.textContent = resultName;
      Object.entries(data.stats).forEach(([key, value]) => {
        const target = root.querySelector<HTMLElement>(`[data-stat="${key}"]`);
        if (target) target.textContent = new Intl.NumberFormat(language()).format(value);
      });
      if (results) results.hidden = false;
      renderMap(data);
      renderNetworkList(data, networkSearch?.value ?? "");
      results?.scrollIntoView({ behavior: "smooth", block: "start" });
      updateStatus("ready", resultName);
    }

    async function processFiles(files: File[]) {
      if (!files.length) return;
      if (files.some((file) => !file.name.toLowerCase().endsWith(".csv"))) {
        updateStatus("error", copy[language()].invalidType);
        return;
      }
      const oversized = files.find((file) => file.size > MAX_FILE_SIZE);
      if (oversized) {
        updateStatus("error", `${oversized.name}: ${copy[language()].tooLarge}`);
        return;
      }
      if (files.reduce((total, file) => total + file.size, 0) > MAX_TOTAL_SIZE) {
        updateStatus("error", copy[language()].totalTooLarge);
        return;
      }

      updateStatus("reading");
      try {
        const parsed = await Promise.all(files.map(async (file) => {
          try {
            const text = decodeWardrivingFile(await file.arrayBuffer());
            return parseWardrivingCsv(text, file.name);
          } catch (error) {
            const message = error instanceof Error ? error.message : String(error);
            throw new Error(`${file.name}: ${message}`);
          }
        }));
        renderResults(mergeWardrivingMaps(currentData ? [currentData, ...parsed] : parsed));
        if (input) input.value = "";
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        updateStatus("error", copy[language()].error(message));
      }
    }

    input?.addEventListener("change", () => {
      const files = [...(input.files ?? [])];
      if (files.length) void processFiles(files);
    });

    addFilesButton?.addEventListener("click", () => input?.click());

    ["dragenter", "dragover"].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropzone.classList.add("is-dragging");
      });
    });
    ["dragleave", "drop"].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropzone.classList.remove("is-dragging");
      });
    });
    dropzone?.addEventListener("drop", (event) => {
      const files = [...(event.dataTransfer?.files ?? [])];
      if (files.length) void processFiles(files);
    });

    clearButton?.addEventListener("click", () => {
      currentData = null;
      map?.remove();
      map = null;
      if (mapElement) mapElement.replaceChildren();
      if (results) results.hidden = true;
      if (input) input.value = "";
      if (networkSearch) networkSearch.value = "";
      if (securityFilter) securityFilter.value = "all";
      networkList?.replaceChildren();
      updateStatus("idle");
      dropzone?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    downloadButton?.addEventListener("click", () => {
      if (!currentData) return;
      const blob = new Blob([buildStandaloneWardrivingHtml(currentData)], { type: "text/html;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = currentData.fileNames.length > 1
        ? `WARD_DRIVE_${currentData.fileNames.length}_ARCHIVOS_MAP.html`
        : `${currentData.fileName.replace(/\.csv$/i, "") || "WARD_DRIVE"}_MAP.html`;
      link.click();
      URL.revokeObjectURL(url);
    });

    networkSearch?.addEventListener("input", () => {
      if (currentData) renderNetworkList(currentData, networkSearch.value, selectedSecurityFilter());
    });

    securityFilter?.addEventListener("change", () => {
      if (currentData) renderNetworkList(currentData, networkSearch?.value ?? "", selectedSecurityFilter(), true);
    });

    resetFiltersButton?.addEventListener("click", () => {
      if (networkSearch) networkSearch.value = "";
      if (securityFilter) securityFilter.value = "all";
      if (currentData) renderNetworkList(currentData, "", "all", true);
    });

    basemapSelect?.addEventListener("change", applyBasemap);

    document.addEventListener("site-language-change", () => {
      updateStatus(currentStatus.state, currentStatus.detail);
      if (currentData) renderResults(currentData);
    });
  }
</script>

